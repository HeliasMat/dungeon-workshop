# A game of the tests only (Test Village): never offered by the Workshop.
title: Test Village
author: the tests
team: pikachu piplup
home: test_market south

chapter 1 "Chapter 1"
  play arrival
  go test_market south
  on talk pidgeot
    dungeon test_forest
    if won
      set fireflies_back
      chapter 2
    end
  end
end

chapter 2 "Chapter 2"
  play back_home
  on talk kecleon if not thanked
    set thanked
    play thanks
    finish
  end
end
